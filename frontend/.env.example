# URL base pública da API Xano de Pacientes, sem a rota /pacientes e sem credenciais.
# Exemplo de formato: https://<instancia>.xano.io/api:<grupo>
XANO_API_URL=

# URL base pública da API Xano de Triagem, sem as rotas /fichas e /sintomas.
XANO_TRIAGEM_API_URL=

# URL base pública da API Xano de Autenticação, sem as rotas /auth/...
XANO_AUTH_API_URL=

# Chave do dispositivo Totem: o mesmo valor da variável TOTEM_CHAVE no Xano.
# Fica só no servidor do Reflex (nunca vai ao navegador). Não versionar o valor real.
TOTEM_CHAVE=

# Token temporário de Recepção/Triagem para executar test_xano_api_integration.py.
# Não versionar valores reais; sem token, essa integração é ignorada.
TEST_RECEPCAO_TOKEN=
